# ─────────────────────────────────────────────────────────────────────
#  Atlas — example environment file.
#  Copy to `.env` and fill in.  `.env` is gitignored, forever.
#  NEVER paste real keys into a chat, an issue, a commit or a screenshot.
# ─────────────────────────────────────────────────────────────────────

# ── Cloud brains (free tiers are enough for a voice assistant) ───────
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Together: https://api.together.xyz/settings/api-keys
TOGETHER_API_KEY=

# Hugging Face: https://huggingface.co/settings/tokens  (needs "Inference" permission)
HUGGINGFACE_API_KEY=

# ── Local engines (no key needed; leave blank) ───────────────────────
# llama.cpp sidecar (Bunker brain)  →  http://127.0.0.1:8123/v1
# Ollama (alternative)              →  http://127.0.0.1:11434/v1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
LLAMACPP_BASE_URL=http://127.0.0.1:8123/v1

# ── Obsidian second brain ────────────────────────────────────────────
# Path to your Atlas vault (created by `python -m atlas vault init <path>`)
ATLAS_VAULT_PATH=
# Optional: Local REST API plugin key (only if you want live vault access)
OBSIDIAN_API_KEY=

# ── Overrides (optional) ─────────────────────────────────────────────
# ATLAS_PROFILE=lean
# ATLAS_CONFIG=./config.toml
